# 所有部署参数在本文件配置。部署脚本自动读取，不会 source/执行本文件。
# .env 已随包提供；首次 ./deploy.sh up 会将 __AUTO__ 替换成独立随机密码。
# 格式 KEY=value 或 KEY='value'；不支持变量插值、多行、行尾注释、转义。
COMPOSE_PROJECT_NAME=zentao
TZ=Asia/Shanghai
PLATFORM=linux/amd64
ZENTAO_IMAGE=easysoft/zentao:22.7
DB_IMAGE=mariadb:10.11.19
# 可设绝对路径；相对路径始终以部署包目录为基准。不要把路径设为 /。
DATA_DIR=./data
LOG_DIR=./logs
BACKUP_DIR=./backups
# 对外 HTTP 端口；若服务器前置反向代理，可将 BIND_IP 改成 127.0.0.1。
BIND_IP=0.0.0.0
HTTP_PORT=8080
RESTART_POLICY=unless-stopped
START_TIMEOUT=600
STOP_TIMEOUT=120
# 数据库只在 Docker 内网开放，不发布到宿主机。
DB_NAME=zentao
DB_USER=zentao
DB_PASSWORD=__AUTO__
DB_ROOT_PASSWORD=__AUTO__
DB_INNODB_BUFFER_POOL_SIZE=256M
DB_MAX_CONNECTIONS=200
DB_SLOW_QUERY_LOG=1
DB_LONG_QUERY_TIME=2
# 禅道自带 Apache、PHP；文件 session 持久化，无需额外 Redis。
ZT_WEB_ROOT=/
ZT_ADMINER_ENABLE=false
ZT_CHECK_OWNER=true
RR_INTERNAL=true
PHP_MAX_EXECUTION_TIME=300
PHP_MEMORY_LIMIT=512M
PHP_POST_MAX_SIZE=128M
PHP_UPLOAD_MAX_FILESIZE=128M
PHP_MAX_INPUT_VARS=5000
# Docker 控制台日志轮转（应用文件日志保存在 LOG_DIR，见 README）。
DOCKER_LOG_MAX_SIZE=20m
DOCKER_LOG_MAX_FILE=5
# 可选 SMTP（官方镜像通常在安装完成后应用配置；详见 README）。
SMTP_ENABLED=false
SMTP_FROMNAME='ZenTao'
SMTP_HOST=127.0.0.1
SMTP_PORT=25
SMTP_USER=
SMTP_PASS=
# 可选 LDAP
LDAP_ENABLED=false
LDAP_HOST=127.0.0.1
LDAP_PORT=389
LDAP_BASEDN=dc=example,dc=com
LDAP_ADMINUSER=cn=admin,dc=example,dc=com
LDAP_BINDPASSWORD=
LDAP_USERKEY=uid
LDAP_EMAILKEY=mail
LDAP_GROUP=2
LDAP_REALNAME=cn
LDAP_REPEATPOLICY=number
LDAP_AUTOCREATE=1
